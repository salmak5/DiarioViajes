<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#F0F4FF"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ==================== TOOLBAR ==================== -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#1A237E"
        android:elevation="4dp"
        app:titleTextColor="#FFFFFF"
        app:subtitleTextColor="#B0C4FF"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" />

    <!-- ==================== CABECERA PERFIL ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#1A237E"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/imgFotoUsuario"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/perfil"
            android:scaleType="centerCrop"
            android:background="#FFFFFF"
            android:padding="4dp"
            android:layout_marginEnd="16dp"
            android:elevation="4dp"
            android:contentDescription="Foto de perfil" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombreUsuario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cargando usuario..."
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bienvenido a tu Diario de Viajes"
                android:textColor="#B0C4FF"
                android:textSize="14sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- ==================== CONTENIDO PRINCIPAL ==================== -->
    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:text="@string/titulo_home"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#1A237E"
            android:layout_marginBottom="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- Buscador -->
        <EditText
            android:id="@+id/etBuscador"
            android:hint="@string/hint_buscador"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:layout_marginBottom="12dp"
            android:inputType="text"
            android:elevation="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- Botón Nuevo Viaje -->
        <Button
            android:id="@+id/btnNuevoViaje"
            android:text="@string/btn_nuevo_viaje"
            android:backgroundTint="#1A237E"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="20dp"
            android:elevation="3dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvViajes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp"/>

    </LinearLayout>

</LinearLayout>